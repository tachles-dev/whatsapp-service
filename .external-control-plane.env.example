# External control-plane application environment example.
# This file is for your separate onboarding platform, not for the gateway itself.

WGS_URL=https://wa.example.com
WGS_API_BASE_PATH=/api/v1

# Full-access machine credential for the gateway instance.
WGS_MASTER_KEY=replace-with-instance-api-key

# Required when the gateway is configured to restrict master-key callers.
WGS_CONTROL_PLANE_HEADER=x-control-plane-key
WGS_CONTROL_PLANE_SECRET=replace-with-instance-control-plane-secret

# Optional hardening if your outbound IPs are static and the gateway uses CONTROL_PLANE_ALLOWED_IPS.
# EXTERNAL_CONTROL_PLANE_PUBLIC_IP=203.0.113.10